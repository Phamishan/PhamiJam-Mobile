<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.phamishan.phamijam.widget</string>
	</array>
	<!-- Universal Links for shared song/playlist links (see PhamiJam-Share-Worker). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:phamijam-share.phamijam.workers.dev</string>
	</array>
</dict>
</plist>
